# Variáveis do OAuth Mercado Livre
# APP ID da aplicação criada no DevCenter do Mercado Livre.
MELI_CLIENT_ID=

# Secret Key da aplicação. Nunca exponha no frontend ou nos logs.
MELI_CLIENT_SECRET=

# Deve ser exatamente a URI cadastrada no DevCenter.
MELI_REDIRECT_URI=https://comercio-popular-backend-production.up.railway.app

# true habilita PKCE S256; false usa Authorization Code sem PKCE.
MELI_USE_PKCE=true

# URL opcional para redirecionar o navegador após conexão concluída.
MELI_OAUTH_SUCCESS_REDIRECT_URL=

# Chave AES-256 para criptografar access/refresh tokens no PostgreSQL.
# Gere 32 bytes aleatórios e armazene como 64 caracteres hexadecimais.
MELI_OAUTH_ENCRYPTION_KEY=

# App ID esperado nos webhooks do Mercado Livre.
MELI_APP_ID=

# Token legado temporário. Será usado apenas como fallback enquanto a nova
# conexão OAuth ainda não tiver sido autorizada.
MELI_ACCESS_TOKEN=
# Domínios permitidos para links SHEIN gerados pelo conversor (opcional; ajuste ao link real).
# SHEIN_AFFILIATE_HOSTS=shein.top,onelink.shein.com
# Domínio padrão de páginas de produto SHEIN (opcional).
# SHEIN_PRODUCT_HOSTS=br.shein.com

# AliExpress Affiliate Open Platform
# Crie um aplicativo no Open Platform e guarde estes valores somente no backend/Railway.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# O endpoint pode ser alterado caso o console indique outro ambiente.
ALIEXPRESS_API_ENDPOINT=https://eco.taobao.com/router/rest
ALIEXPRESS_PARTNER_ID=comercio-popular

# Origens autorizadas para chamadas do navegador. Separe várias por vírgula.
FRONTEND_ORIGINS=https://comerciopopular.shop,http://localhost:5173

# Mercado Pago Checkout Pro
# Use o Access Token da aba Teste durante a homologação.
# Nunca coloque este valor no frontend ou no Git.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SPLIT_ENABLED=false
# Comissão da plataforma por venda. O padrão 0 preserva o plano "zero comissão".
MERCADOPAGO_MARKETPLACE_FEE_PERCENT=0
MERCADOPAGO_MARKETPLACE_FEE_FIXED=0
# Credenciais da aplicação Marketplace criada no Mercado Pago.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://comercio-popular-backend-production.up.railway.app/api/mercadopago/marketplace/callback
# Gere com: openssl rand -hex 32. Nunca reutilize JWT_SECRET.
MERCADOPAGO_OAUTH_ENCRYPTION_KEY=
# Chave secreta gerada em Mercado Pago > Webhooks > Configurar notificações.
MERCADOPAGO_WEBHOOK_SECRET=
# Ative como true somente depois de preencher a chave acima no Railway.
MERCADOPAGO_REQUIRE_WEBHOOK_SIGNATURE=false
FRONTEND_URL=https://comerciopopular.shop
BACKEND_PUBLIC_URL=https://comercio-popular-backend-production.up.railway.app


# E-mails autorizados a aprovar ou recusar cadastros de comerciantes.
ADMIN_EMAILS=
