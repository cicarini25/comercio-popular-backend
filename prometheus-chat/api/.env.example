PORT=3334
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/prometheus_dev
JWT_SECRET=copy-only-the-local-account-api-secret
ACCOUNT_API_BASE_URL=http://localhost:3333/api
PROMETHEUS_ACCOUNT_TIMEOUT_MS=15000
PROMETHEUS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PROMETHEUS_COOKIE_SECURE=false
PROMETHEUS_COOKIE_SAME_SITE=lax

# Configure only on the chat service. Never send these values to the browser.
# The Ollama endpoint must be reachable from this API process/container.
PROMETHEUS_OLLAMA_BASE_URL=
PROMETHEUS_OLLAMA_MODEL=llama3.2:3b
PROMETHEUS_OLLAMA_TIMEOUT_MS=120000
PROMETHEUS_OLLAMA_MAX_TOKENS=512

# Use a separate Manus key dedicated to the Prometheus public chat.
# This is intentionally independent from the private AEGIS-X configuration.
PROMETHEUS_MANUS_API_KEY=
PROMETHEUS_MANUS_API_BASE=https://api.manus.ai/v2
PROMETHEUS_MANUS_TIMEOUT_MS=30000
